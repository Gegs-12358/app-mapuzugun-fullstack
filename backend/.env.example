DB_USER=postgres
DB_HOST=localhost
DB_NAME=mapuzugun_db
DB_PASSWORD=
DB_PORT=5432
PORT=3000
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
CORS_ORIGIN=http://localhost:8100,https://localhost,capacitor://localhost
# true = muestra también el contenido en borrador (solo para desarrollo)
CONTENIDO_BORRADOR=false
# Correo para recuperar contraseñas (Brevo, plan gratuito). Sin estas dos, no se pide correo.
BREVO_API_KEY=
CORREO_REMITENTE=
# true = (solo desarrollo) los códigos se muestran en el registro del servidor en vez de enviarse
CORREO_PRUEBA=false

# Avisos web (notificaciones del navegador). Genera las claves con:
#   npx web-push generate-vapid-keys
# Sin estas claves, los avisos web quedan apagados y la app funciona igual.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACTO=mailto:kimankeapp@gmail.com
# Secreto que manda la tarea programada (cron-job.org) en el encabezado x-avisos-secreto
AVISOS_SECRETO=
